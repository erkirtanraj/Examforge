# Local-only example. Copy values into backend/.env; never commit real secrets.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=examforge_app
MYSQL_PASSWORD=CHANGE_ME_LOCALLY
MYSQL_DATABASE=examforge_local
MYSQL_POOL_SIZE=5
MYSQL_MAX_OVERFLOW=10
MYSQL_POOL_TIMEOUT=30
MYSQL_POOL_RECYCLE=1800

# Optional alternative:
# DATABASE_URL=mysql+asyncmy://examforge_app:URL_ENCODED_PASSWORD@127.0.0.1:3306/examforge_local?charset=utf8mb4
